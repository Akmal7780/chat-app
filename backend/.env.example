# Leave unset for local dev (defaults to DEBUG=True, ALLOWED_HOSTS=*).
# Before deploying anywhere but localhost, set:
#   DEBUG=False
#   ALLOWED_HOSTS=your-domain.com,www.your-domain.com
DEBUG=
ALLOWED_HOSTS=

# Max size (in MB) for a single chat file upload. Defaults to 500 if unset.
MAX_UPLOAD_SIZE_MB=

# Optional error monitoring — leave blank to disable.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=

# Optional Web Push — leave blank to disable. Generate with:
#   docker compose exec backend python manage.py generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_SECRET_KEY=

SECRET_KEY=